# ---- secrets: never commit ----
.env
.env.*
!.env.example

# ---- python environment ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- data ----
# Downloaded and derived corpora are rebuilt by scripts rather than committed.
# The synthetic operations corpus is the exception: it is ours, it is small, and
# the evaluation labels reference these exact files, so it must be versioned.
# The rule: content we authored and that is small enough to read is versioned.
# Content derived from third-party datasets is rebuilt by script instead.
data/*
!data/corpus/
data/corpus/*
!data/corpus/ops/
!data/eval/
data/eval/*
!data/eval/ops_questions.jsonl
# The combined question set is the answer key the evaluation is scored
# against, so it is versioned. Reports derived from it are not.
!data/eval/test_set.jsonl
# Analysis documents live in docs/, not here.

# ---- model weights / HF cache ----
models/
.cache/

# ---- editors / OS ----
.idea/
.vscode/
.DS_Store
