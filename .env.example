# Copy this file to .env and fill in the three values under "required".
# .env is gitignored and must never be committed.
# Every name here maps to a field in src/ragsys/config.py, which holds the
# defaults for everything not listed.

# ---------- required ----------
# Qdrant Cloud, or http://localhost:6333 for a local container.
QDRANT_URL=
QDRANT_API_KEY=
# The key for whichever provider LLM_PROVIDER names.
LLM_API_KEY=

# ---------- optional: answer generation ----------
# Defaults to gemini. LLM_MODEL may be left empty, in which case the provider's
# fallback chain in src/ragsys/reasoning/llm.py is used.
LLM_PROVIDER=gemini
LLM_MODEL=

# ---------- optional: answer evaluation ----------
# Only needed to run scripts/evaluate.py --answers. Set a provider different
# from LLM_PROVIDER so that no model grades output from its own family; with
# these empty, grading falls back to the generator's key and the report says
# self-preference was reduced rather than eliminated.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=

# ---------- optional: everything else ----------
LOG_LEVEL=INFO
QDRANT_COLLECTION=ragsys_chunks

# Chunking is deliberately NOT listed here. CHUNK_STRATEGY, CHUNK_SIZE and
# CHUNK_OVERLAP describe how the index was built, so changing them in .env
# does not re-chunk anything -- it only makes the settings stop matching the
# stored vectors and the sparse statistics file. To change them, edit
# src/ragsys/config.py and rebuild with scripts/build_chunks.py and
# scripts/build_index.py.
