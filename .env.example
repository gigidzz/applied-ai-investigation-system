# Copy this file to .env and fill in the values you need.
# .env is gitignored and must never be committed.
# Every name below maps to a field in src/ragsys/config.py.

# ---------- logging ----------
LOG_LEVEL=INFO

# ---------- document chunking ----------
CHUNK_STRATEGY=structural
CHUNK_SIZE=160
CHUNK_OVERLAP=40

# ---------- vector store ----------
# Qdrant Cloud, or http://localhost:6333 for a local container.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ragsys_chunks

# ---------- answer generation ----------
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# ---------- answer evaluation ----------
# Use a different provider from LLM_PROVIDER so that a model never grades
# its own output.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=
